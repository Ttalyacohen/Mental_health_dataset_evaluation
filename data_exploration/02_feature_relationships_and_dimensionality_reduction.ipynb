    "    \"\\n\",\n",
    "    \"fig = plt.figure(figsize=(16, 7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, (elev, azim) in enumerate(views):\\n\",\n",
    "    \"    ax = fig.add_subplot(1, 2, i + 1, projection='3d')\\n\",\n",
    "    \"    for j, lvl in enumerate(STRESS_ORDER):\\n\",\n",
    "    \"        mask = df['Stress_Level'] == lvl\\n\",\n",
    "    \"        ax.scatter(x[mask], y[mask], z[mask],\\n\",\n",
    "    \"                   s=12, alpha=0.5, color=stress_palette[j], label=lvl)\\n\",\n",
    "    \"    ax.set_xlabel('Sleep Hours / Night')\\n\",\n",
    "    \"    ax.set_ylabel('Physical Activity Hours')\\n\",\n",
    "    \"    ax.set_zlabel('Mental Health Score')\\n\",\n",
    "    \"    ax.view_init(elev=elev, azim=azim)\\n\",\n",
    "    \"    ax.set_title(f'View {i + 1}  (elev={elev}°, azim={azim}°)')\\n\",\n",
    "    \"    ax.legend(title='Stress Level', markerscale=2, fontsize=8, loc='upper left')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig.suptitle('3D Scatter — Sleep vs. Physical Activity vs. Mental Health Score '\\n\",\n",
    "    \"             '(coloured by Stress Level)', fontsize=13)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
