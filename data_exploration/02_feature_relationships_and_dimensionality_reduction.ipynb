    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Consensus: top-5 in at least 2 of the 3 rank-based methods\\n\",\n",
    "    \"def top5(rank_series):\\n\",\n",
    "    \"    return rank_series <= 5\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary_table['Consensus Score'] = (\\n\",\n",
    "    \"    top5(summary_table['MI Rank']).astype(int) +\\n\",\n",
