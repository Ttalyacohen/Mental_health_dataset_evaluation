    "   \"source\": [\n",
    "    \"import os, pooch, warnings\\n\",\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import plotly.express as px\\n\",\n",
    "    \"import pycountry\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Download/cache Natural Earth 110m countries (geopandas ≥1.0 removed the bundled copy)\\n\",\n",
    "    \"_world_zip = pooch.retrieve(\\n\",\n",
    "    \"    url='https://naciscdn.org/naturalearth/110m/cultural/ne_110m_admin_0_countries.zip',\\n\",\n",
    "    \"    known_hash='0f243aeac8ac6cf26f0417285b0bd33ac47f1b5bdb719fd3e0df37d03ea37110',\\n\",\n",
    "    \"    path=os.path.join('..', 'dataset'),\\n\",\n",
    "    \"    fname='ne_110m_admin_0_countries.zip',\\n\",\n",
    "    \")\\n\",\n",
    "    \"world = gpd.read_file(_world_zip)\\n\",\n",
    "    \"world = world[world['NAME'] != 'Antarctica'].copy()\\n\",\n",
    "    \"# ISO_A3_EH handles France/Norway; ADM0_A3 covers the last remaining -99 edge cases\\n\",\n",
    "    \"world['merge_iso'] = world['ISO_A3_EH'].where(world['ISO_A3_EH'] != '-99', world['ADM0_A3'])\\n\",\n",
    "    \"WORLD_ISO_COL = 'merge_iso'   # use this when joining country_stats → world\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Aggregate per real country (exclude unmappable 'Other')\\n\",\n",
    "    \"geo_df = df[df['Country'] != 'Other'].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"country_stats = (\\n\",\n",
    "    \"    geo_df.groupby('Country')\\n\",\n",
    "    \"    .agg(\\n\",\n",
    "    \"        mean_mh=('Mental_Health_Score', 'mean'),\\n\",\n",
    "    \"        mean_usage=('Avg_Daily_Usage_Hours', 'mean'),\\n\",\n",
    "    \"        mean_study=('Study_Hours', 'mean'),\\n\",\n",
    "    \"        mean_sleep=('Sleep_Hours_Per_Night', 'mean'),\\n\",\n",
    "    \"        count=('Mental_Health_Score', 'count'),\\n\",\n",
    "    \"        top_platform=('Most_Used_Platform', lambda x: x.mode()[0])\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    .reset_index()\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Countries with data (excluding \\\"Other\\\"): {len(country_stats)}')\\n\",\n",
