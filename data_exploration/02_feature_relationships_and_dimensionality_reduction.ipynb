    "    \"x = df['Sleep_Hours_Per_Night']\\n\",\n",
    "    \"y = df['Physical_Activity_Hours']\\n\",\n",
    "    \"z = df[TARGET]\\n\",\n",
    "    \"\\n\",\n",
