    "      ]\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(2, 3, figsize=(16, 10))\\n\",\n",
    "    \"axes = axes.flatten()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, col in enumerate(CATEGORICAL_COLS):\\n\",\n",
    "    \"    ax = axes[i]\\n\",\n",
    "    \"    order = df.groupby(col)[TARGET].median().sort_values().index.tolist()\\n\",\n",
    "    \"    sns.boxplot(data=df, x=col, y=TARGET, order=order,\\n\",\n",
    "    \"                palette='Set2', ax=ax,\\n\",\n",
    "    \"                flierprops=dict(marker='o', markersize=2, alpha=0.3))\\n\",\n",
    "    \"    groups = [df.loc[df[col] == cat, TARGET].values for cat in order]\\n\",\n",
    "    \"    f_stat, p_val = stats.f_oneway(*groups)\\n\",\n",
    "    \"    p_str = f'{p_val:.2e}' if p_val < 0.001 else f'{p_val:.4f}'\\n\",\n",
    "    \"    ax.set_title(f'{col.replace(\\\"_\\\", \\\" \\\")}\\\\nANOVA F={f_stat:.2f}, p={p_str}')\\n\",\n",
    "    \"    ax.set_xlabel('')\\n\",\n",
    "    \"    ax.tick_params(axis='x', rotation=30)\\n\",\n",
    "    \"\\n\",\n",
    "    \"axes[-1].set_visible(False)\\n\",\n",
    "    \"fig.suptitle('Mental Health Score by Categorical Feature', fontsize=14, y=1.01)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
