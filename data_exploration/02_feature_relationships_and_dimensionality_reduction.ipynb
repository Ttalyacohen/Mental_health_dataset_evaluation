    "    \"### 10b. Wrapper Method — RFE & RFECV\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 22,\n",
    "   \"id\": \"c8de851390f5c919\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-27T19:38:39.480353Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-27T19:38:39.480261Z\",\n",
