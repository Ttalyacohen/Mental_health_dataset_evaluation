    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"MANUAL_OVERRIDES = {\\n\",\n",
    "    \"    'USA':          'United States',\\n\",\n",
    "    \"    'UK':           'United Kingdom',\\n\",\n",
    "    \"    'Turkey':       'Turkiye',\\n\",\n",
    "    \"    'UAE':          'United Arab Emirates',\\n\",\n",
    "    \"    'South Korea':  'Korea, Republic of',\\n\",\n",
    "    \"    'North Korea':  \\\"Korea, Democratic People's Republic of\\\",\\n\",\n",
    "    \"    'Iran':         'Iran, Islamic Republic of',\\n\",\n",
    "    \"    'Russia':       'Russian Federation',\\n\",\n",
    "    \"    'Bolivia':      'Bolivia, Plurinational State of',\\n\",\n",
    "    \"    'Venezuela':    'Venezuela, Bolivarian Republic of',\\n\",\n",
    "    \"    'Syria':        'Syrian Arab Republic',\\n\",\n",
    "    \"    'Tanzania':     'Tanzania, United Republic of',\\n\",\n",
    "    \"    'Laos':         \\\"Lao People's Democratic Republic\\\",\\n\",\n",
    "    \"    'Vietnam':      'Viet Nam',\\n\",\n",
    "    \"    'Taiwan':       'Taiwan, Province of China',\\n\",\n",
    "    \"    'Palestine':    'Palestine, State of',\\n\",\n",
    "    \"    'Moldova':      'Moldova, Republic of',\\n\",\n",
    "    \"    'Ivory Coast':  \\\"Côte d'Ivoire\\\",\\n\",\n",
    "    \"    'Trinidad':     'Trinidad and Tobago',\\n\",\n",
    "    \"    'DR Congo':     'Congo, The Democratic Republic of the',\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_iso3(name):\\n\",\n",
    "    \"    search_name = MANUAL_OVERRIDES.get(name, name)\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        return pycountry.countries.search_fuzzy(search_name)[0].alpha_3\\n\",\n",
    "    \"    except LookupError:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"country_stats['iso_alpha3'] = country_stats['Country'].apply(get_iso3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"unmapped = country_stats[country_stats['iso_alpha3'].isna()]['Country'].tolist()\\n\",\n",
    "    \"if unmapped:\\n\",\n",
    "    \"    print(f'Could not map {len(unmapped)} country/ies: {unmapped}')\\n\",\n",
    "    \"    print('Add them to MANUAL_OVERRIDES or check dataset spelling.')\\n\",\n",
    "    \"country_stats = country_stats.dropna(subset=['iso_alpha3']).copy()\\n\",\n",
    "    \"print(f'Successfully mapped countries: {len(country_stats)}')\"\n",
    "   ]\n",
