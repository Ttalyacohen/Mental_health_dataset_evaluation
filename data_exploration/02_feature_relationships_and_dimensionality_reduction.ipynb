    "    \"# RFECV — find optimal number of features automatically\\n\",\n",
    "    \"rfecv = RFECV(\\n\",\n",
    "    \"    estimator=RandomForestRegressor(n_estimators=50, random_state=42, n_jobs=-1),\\n\",\n",
