    "   \"source\": [\n",
    "    \"# Scree plot\\n\",\n",
    "    \"evr = pca.explained_variance_ratio_\\n\",\n",
    "    \"cumulative = np.cumsum(evr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 4))\\n\",\n",
    "    \"ax.bar(range(1, len(evr) + 1), evr * 100, color='steelblue', alpha=0.7, label='Individual')\\n\",\n",
    "    \"ax2 = ax.twinx()\\n\",\n",
    "    \"ax2.plot(range(1, len(cumulative) + 1), cumulative * 100, 'r-o',\\n\",\n",
    "    \"         markersize=4, lw=2, label='Cumulative')\\n\",\n",
    "    \"ax2.axhline(80, color='grey', lw=1, linestyle='--', label='80% threshold')\\n\",\n",
    "    \"ax.set_xlabel('Principal Component')\\n\",\n",
    "    \"ax.set_ylabel('Explained Variance (%)')\\n\",\n",
    "    \"ax2.set_ylabel('Cumulative Explained Variance (%)')\\n\",\n",
    "    \"ax.set_title('PCA — Scree Plot')\\n\",\n",
    "    \"lines1, labels1 = ax.get_legend_handles_labels()\\n\",\n",
    "    \"lines2, labels2 = ax2.get_legend_handles_labels()\\n\",\n",
    "    \"ax.legend(lines1 + lines2, labels1 + labels2, loc='center right')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"n_80 = np.argmax(cumulative >= 0.80) + 1\\n\",\n",
