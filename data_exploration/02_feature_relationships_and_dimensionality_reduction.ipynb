    "     \"text\": [\n",
    "      \"RFE selected features:\\n\",\n",
    "      \"['Avg_Daily_Usage_Hours', 'Daily_Unlocks', 'Study_Hours', 'Physical_Activity_Hours', 'Sleep_Hours_Per_Night']\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"rf_base = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"rfe = RFE(estimator=rf_base, n_features_to_select=5)\\n\",\n",
    "    \"rfe.fit(X_for_selection, y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"rfe_df = pd.DataFrame({\\n\",\n",
    "    \"    'Feature': feat_names_no_target,\\n\",\n",
    "    \"    'Selected': rfe.support_,\\n\",\n",
    "    \"    'Rank': rfe.ranking_\\n\",\n",
    "    \"}).sort_values('Rank')\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(9, max(5, len(rfe_df) * 0.28)))\\n\",\n",
    "    \"colors = ['tomato' if s else 'lightgrey' for s in rfe_df['Selected']]\\n\",\n",
    "    \"ax.barh(rfe_df['Feature'], rfe_df['Rank'].max() + 1 - rfe_df['Rank'], color=colors)\\n\",\n",
    "    \"ax.set_xlabel('RFE Importance Score (higher = better ranked)')\\n\",\n",
    "    \"ax.set_title('RFE Feature Ranking (top-5 selected)')\\n\",\n",
    "    \"ax.legend(handles=[\\n\",\n",
    "    \"    mpatches.Patch(color='tomato', label='Selected (top 5)'),\\n\",\n",
    "    \"    mpatches.Patch(color='lightgrey', label='Eliminated'),\\n\",\n",
    "    \"])\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
