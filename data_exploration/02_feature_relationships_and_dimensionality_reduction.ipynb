    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 9. Correlation Between Reduced Dimensions and Target\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"6a4be56716a7c975\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"**Understanding the p-value.** Here each reduced dimension (PCA / t-SNE) is correlated with the target. The *null hypothesis* is **no correlation**; the **p-value** is the chance of observing this correlation by luck under that null. **p ≤ 0.05** flags a statistically significant association.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 20,\n",
    "   \"id\": \"79b2827d0d289286\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T17:14:26.948307Z\",\n",
    "     \"start_time\": \"2026-07-27T17:14:26.871923Z\"\n",
    "    },\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-27T19:38:37.645654Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-27T19:38:37.645566Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-27T19:38:37.705789Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-27T19:38:37.705502Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"image/png\": \"\",\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 880x440 with 1 Axes>\"\n",
    "      ]\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Method Dimension  Pearson r      p-value\\n\",\n",
    "      \"   PCA     PCA 1  -0.828016 0.000000e+00\\n\",\n",
    "      \"   PCA     PCA 2  -0.078309 2.967911e-08\\n\",\n",
    "      \" t-SNE   t-SNE 1  -0.236115 2.785016e-64\\n\",\n",
    "      \" t-SNE   t-SNE 2  -0.055765 7.996865e-05\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"results = []\\n\",\n",
    "    \"for name, coords in [('PCA', X_pca[:, :2]), ('t-SNE', X_tsne)]:\\n\",\n",
    "    \"    for dim_i in range(2):\\n\",\n",
    "    \"        r, p = stats.pearsonr(coords[:, dim_i], mental_score)\\n\",\n",
    "    \"        results.append({'Method': name, 'Dimension': f'{name} {dim_i+1}',\\n\",\n",
    "    \"                        'Pearson r': r, 'p-value': p})\\n\",\n",
    "    \"\\n\",\n",
    "    \"res_df = pd.DataFrame(results)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(8, 4))\\n\",\n",
    "    \"colors = ['steelblue' if r >= 0 else 'tomato' for r in res_df['Pearson r']]\\n\",\n",
    "    \"bars = ax.barh(res_df['Dimension'], res_df['Pearson r'], color=colors)\\n\",\n",
    "    \"ax.axvline(0, color='black', lw=0.8)\\n\",\n",
    "    \"for bar, row in zip(bars, res_df.itertuples()):\\n\",\n",
    "    \"    x = bar.get_width()\\n\",\n",
    "    \"    p_str = f'p={row._4:.2e}' if row._4 < 0.001 else f'p={row._4:.4f}'\\n\",\n",
    "    \"    ax.text(x + (0.003 if x >= 0 else -0.003), bar.get_y() + bar.get_height() / 2,\\n\",\n",
    "    \"            f'r={x:.3f}, {p_str}', va='center', ha='left' if x >= 0 else 'right', fontsize=8)\\n\",\n",
    "    \"ax.set_xlabel('Pearson r with Mental Health Score')\\n\",\n",
    "    \"ax.set_title('Correlation of Reduced Dimensions with Target')\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(res_df.to_string(index=False))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
