    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"# Build feature matrix: numeric + ordinal-encoded Stress + one-hot categoricals\\n\",\n",
    "    \"feature_cols = [c for c in NUMERIC_COLS if c != TARGET]\\n\",\n",
    "    \"df_enc = df[feature_cols].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_enc['Stress_Level_Enc'] = df['Stress_Level_Enc']\\n\",\n",
    "    \"df_ohe = pd.get_dummies(df[CATEGORICAL_COLS], drop_first=False)\\n\",\n",
    "    \"X_full = pd.concat([df_enc, df_ohe], axis=1).astype(float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"scaler = StandardScaler()\\n\",\n",
    "    \"X_scaled = scaler.fit_transform(X_full)\\n\",\n",
    "    \"feature_names = X_full.columns.tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"pca = PCA(random_state=42)\\n\",\n",
    "    \"X_pca = pca.fit_transform(X_scaled)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Feature matrix shape: {X_scaled.shape}')\\n\",\n",
    "    \"print(f'PCA components: {pca.n_components_}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
