    "   },\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"image/png\": \"\",\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 990x4281.2 with 1 Axes>\"\n",
    "      ]\n",
    "     },\n",
