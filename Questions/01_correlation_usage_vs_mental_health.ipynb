    "    \"        f'{DATA_PATH} not found — run data_exploration/01_data_overview_and_distributions.ipynb first'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"df = pd.read_csv(DATA_PATH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"STRESS_ORDER = ['Low', 'Medium', 'High', 'Very High']\\n\",\n",
    "    \"df['Stress_Level'] = pd.Categorical(df['Stress_Level'], categories=STRESS_ORDER, ordered=True)\\n\",\n",
