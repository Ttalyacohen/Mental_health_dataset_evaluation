    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Simple Linear Regression\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"39a541bd\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-22T12:41:41.954087Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-22T12:41:41.953982Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-22T12:41:41.961128Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-22T12:41:41.960852Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T19:45:58.400187Z\",\n",
    "     \"start_time\": \"2026-07-27T19:45:58.381929Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"X = df[[X_COL]].values\\n\",\n",
    "    \"y = df[Y_COL].values\\n\",\n",
    "    \"\\n\",\n",
    "    \"model = LinearRegression().fit(X, y)\\n\",\n",
    "    \"y_pred = model.predict(X)\\n\",\n",
    "    \"\\n\",\n",
    "    \"r2   = r2_score(y, y_pred)\\n\",\n",
    "    \"rmse = np.sqrt(mean_squared_error(y, y_pred))\\n\",\n",
    "    \"slope     = model.coef_[0]\\n\",\n",
    "    \"intercept = model.intercept_\\n\",\n",
    "    \"\\n\",\n",
    "    \"cv_r2 = cross_val_score(LinearRegression(), X, y, cv=5, scoring='r2')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Regression equation : MH_Score = {slope:.4f} × Usage_Hours + {intercept:.4f}')\\n\",\n",
    "    \"print(f'Train  R²           : {r2:.4f}')\\n\",\n",
    "    \"print(f'5-fold CV R² (mean) : {cv_r2.mean():.4f} ± {cv_r2.std():.4f}')\\n\",\n",
    "    \"print(f'RMSE                : {rmse:.4f}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Regression equation : MH_Score = -0.6311 × Usage_Hours + 9.4361\\n\",\n",
    "      \"Train  R²           : 0.6666\\n\",\n",
    "      \"5-fold CV R² (mean) : 0.6632 ± 0.0230\\n\",\n",
    "      \"RMSE                : 0.7381\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### What the results tell us\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **R² = 0.67** — daily social-media usage alone explains about **67% of the variation** in Mental Health Score. For a single predictor that is a strong fit: two-thirds of the differences between students are accounted for by usage hours, leaving roughly a third to other factors (sleep, stress, activity) and noise.\\n\",\n",
    "    \"- **RMSE = 0.74** — the model's predictions are typically off by only about **±0.74 points** on the Mental Health Score scale. Given the score spans roughly 4–9, being within ~0.74 points is a reasonably accurate prediction.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Together:** a high R² with a low RMSE means the line both *explains* most of the pattern and *predicts* individual scores with modest error — usage hours is a genuinely useful predictor of mental health score, not just a weak trend.\"\n",
    "   ],\n",
    "   \"id\": \"533f7820006dd3f2\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"496b23f7\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-22T12:41:41.962434Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-22T12:41:41.962363Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-22T12:41:42.180790Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-22T12:41:42.180187Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T19:45:58.582785Z\",\n",
    "     \"start_time\": \"2026-07-27T19:45:58.400619Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"residuals = y - y_pred\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(13, 4))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Residuals vs fitted\\n\",\n",
    "    \"ax = axes[0]\\n\",\n",
    "    \"ax.scatter(y_pred, residuals, alpha=0.25, s=12, color='steelblue')\\n\",\n",
    "    \"ax.axhline(0, color='crimson', lw=1.5, linestyle='--')\\n\",\n",
    "    \"ax.set_xlabel('Fitted values')\\n\",\n",
    "    \"ax.set_ylabel('Residuals')\\n\",\n",
    "    \"ax.set_title('Residuals vs Fitted')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Residual distribution\\n\",\n",
    "    \"ax = axes[1]\\n\",\n",
    "    \"sns.histplot(residuals, kde=True, bins=40, color='teal', edgecolor='white', ax=ax)\\n\",\n",
    "    \"ax.set_xlabel('Residual')\\n\",\n",
    "    \"ax.set_title('Residual Distribution')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Residual diagnostic scores\\n\",\n",
    "    \"print(f'Mean residual      : {residuals.mean():.4f}')\\n\",\n",
    "    \"print(f'Std of residuals   : {residuals.std(ddof=1):.4f}')\\n\",\n",
    "    \"print(f'Min / Max residual : {residuals.min():.4f} / {residuals.max():.4f}')\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"<Figure size 1430x440 with 2 Axes>\"\n",
    "      ],\n",
    "      \"image/png\": \"\"\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\",\n",
    "     \"jetTransient\": {\n",
    "      \"display_id\": null\n",
    "     }\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Mean residual      : -0.0000\\n\",\n",
    "      \"Std of residuals   : 0.7381\\n\",\n",
    "      \"Min / Max residual : -2.3904 / 2.2912\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### What the residuals tell us\\n\",\n",
    "    \"\\n\",\n",
    "    \"Residuals are the errors of the model: **residual = actual score − predicted score**. Analysing them checks whether the linear-regression assumptions hold.\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Mean ≈ 0** — the residuals average to essentially zero, so the model is **unbiased**: it doesn't systematically over- or under-predict.\\n\",\n",
    "    \"- **Std ≈ 0.74** — the typical error size, matching the **RMSE**. Most predictions land within ±0.74 points of the true score.\\n\",\n",
    "    \"- **Min / Max ≈ −2.4 / +2.3** — even the worst-case errors are only ~2–3 points, so there are **no extreme outliers**.\\n\",\n",
    "    \"- **Residuals vs Fitted plot** — points scatter as a **flat, structureless band around zero** (correlation with fitted values ≈ 0), indicating **linearity holds** and the error variance is roughly **constant (homoscedastic)**.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Conclusion:** the residual diagnostics support the linear model — errors are unbiased, symmetric, near-normal, outlier-free, and show no leftover pattern. The straight-line fit is appropriate for this relationship.\"\n",
    "   ],\n",
    "   \"id\": \"a30c63651239dbb\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"d3b7163e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Subgroup Analysis\\n\",\n",
    "    \"\\n\",\n",
    "    \"Does the correlation hold within demographic subgroups?\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"**Understanding the p-value.** The same correlation test is run *within each subgroup*. As before, the *null hypothesis* is **no correlation**, and the **p-value** is the chance of seeing this correlation by luck under that null. Watch small subgroups: with few samples, even a fairly large `r` can have a large (non-significant) p-value.\"\n",
    "   ],\n",
    "   \"id\": \"612e3b14ec49f74\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"5cd4d6fb\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-22T12:41:42.183989Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-22T12:41:42.183446Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-22T12:41:42.194449Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-22T12:41:42.193647Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T19:45:58.608881Z\",\n",
    "     \"start_time\": \"2026-07-27T19:45:58.584037Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Pearson r per subgroup\\n\",\n",
    "    \"subgroup_results = []\\n\",\n",
    "    \"for group_col in ['Gender', 'Academic_Level']:\\n\",\n",
    "    \"    for grp, sub in df.groupby(group_col, observed=True):\\n\",\n",
    "    \"        r, p = stats.pearsonr(sub[X_COL], sub[Y_COL])\\n\",\n",
    "    \"        subgroup_results.append({\\n\",\n",
    "    \"            'Group variable': group_col,\\n\",\n",
    "    \"            'Group': grp,\\n\",\n",
    "    \"            'n': len(sub),\\n\",\n",
    "    \"            'Pearson r': round(r, 4),\\n\",\n",
    "    \"            'p-value': p,\\n\",\n",
    "    \"            'Significant': p < 0.05\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"sg_df = pd.DataFrame(subgroup_results)\\n\",\n",
    "    \"print(sg_df.to_string(index=False))\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Group variable         Group    n  Pearson r       p-value  Significant\\n\",\n",
    "      \"        Gender        Female 2364    -0.8317  0.000000e+00         True\\n\",\n",
    "      \"        Gender          Male 2634    -0.8019  0.000000e+00         True\\n\",\n",
    "      \"Academic_Level      Graduate  918    -0.8547 5.477754e-263         True\\n\",\n",
    "      \"Academic_Level   High School  450    -0.8393 1.279309e-120         True\\n\",\n",
    "      \"Academic_Level Undergraduate 3630    -0.7981  0.000000e+00         True\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 9\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"b64ed837\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-22T12:41:42.197236Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-22T12:41:42.197012Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-22T12:41:42.818494Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-22T12:41:42.818200Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T19:45:59.195635Z\",\n",
    "     \"start_time\": \"2026-07-27T19:45:58.609557Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for ax, hue_col, title in zip(\\n\",\n",
    "    \"    axes,\\n\",\n",
    "    \"    ['Gender', 'Academic_Level'],\\n\",\n",
    "    \"    ['By Gender', 'By Academic Level']\\n\",\n",
    "    \"):\\n\",\n",
    "    \"    for group, sub in df.groupby(hue_col, observed=True):\\n\",\n",
    "    \"        r, _ = stats.pearsonr(sub[X_COL], sub[Y_COL])\\n\",\n",
    "    \"        sns.regplot(\\n\",\n",
    "    \"            x=X_COL, y=Y_COL, data=sub, ax=ax,\\n\",\n",
    "    \"            label=f'{group} (r={r:.3f})',\\n\",\n",
    "    \"            scatter_kws={'alpha': 0.15, 's': 10},\\n\",\n",
    "    \"            line_kws={'lw': 2}\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    ax.set_title(f'Usage vs Mental Health Score — {title}')\\n\",\n",
    "    \"    ax.set_xlabel('Avg Daily Usage Hours')\\n\",\n",
    "    \"    ax.set_ylabel('Mental Health Score')\\n\",\n",
    "    \"    ax.legend(fontsize=8)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
