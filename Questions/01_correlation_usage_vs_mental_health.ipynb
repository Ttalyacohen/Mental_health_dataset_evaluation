    "   \"id\": \"f01b7e03\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Binned Box Plot\\n\",\n",
    "    \"\\n\",\n",
    "    \"Grouping usage hours into **one-hour bins** reveals the trend more clearly than individual points.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"5f82c34c\",\n",
    "   \"metadata\": {\n",
    "    \"execution\": {\n",
    "     \"iopub.execute_input\": \"2026-07-22T12:41:41.750210Z\",\n",
    "     \"iopub.status.busy\": \"2026-07-22T12:41:41.750127Z\",\n",
    "     \"iopub.status.idle\": \"2026-07-22T12:41:41.830623Z\",\n",
    "     \"shell.execute_reply\": \"2026-07-22T12:41:41.830350Z\"\n",
    "    },\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-07-27T19:45:58.203539Z\",\n",
    "     \"start_time\": \"2026-07-27T19:45:58.012296Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import math\\n\",\n",
    "    \"\\n\",\n",
    "    \"# One-hour-wide bins covering the full usage range\\n\",\n",
    "    \"max_edge = math.ceil(df[X_COL].max())\\n\",\n",
    "    \"edges = list(range(0, max_edge + 1))                      # 0, 1, 2, ..., max\\n\",\n",
    "    \"bin_order = [f'{lo}\\\\u2013{lo + 1} h' for lo in edges[:-1]]  # '0\\\\u20131 h', '1\\\\u20132 h', ...\\n\",\n",
    "    \"\\n\",\n",
    "    \"df['Usage_Bin'] = pd.cut(\\n\",\n",
    "    \"    df[X_COL],\\n\",\n",
    "    \"    bins=edges,\\n\",\n",
    "    \"    labels=bin_order,\\n\",\n",
    "    \"    include_lowest=True\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"bin_means = df.groupby('Usage_Bin', observed=True)[Y_COL].mean()\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(12, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.boxplot(\\n\",\n",
    "    \"    data=df, x='Usage_Bin', y=Y_COL, order=bin_order,\\n\",\n",
    "    \"    palette='Blues_d', ax=ax,\\n\",\n",
